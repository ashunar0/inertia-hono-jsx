{
  "include": ["app.tsx", "page-props.d.ts", "vite-env.d.ts", "Pages/**/*.tsx"],
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "baseUrl": ".",
    "paths": {
      "@ts-76/inertia-hono-jsx": ["../src/index.ts"]
    },
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx/dom",
    "skipLibCheck": true,
    "noImplicitThis": false,
    "allowSyntheticDefaultImports": true,
    "noEmit": true
  }
}
